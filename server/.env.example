# Copy this file to .env and fill in your own values.
# .env is ignored by Git, so your secrets never get committed.

PORT=3000

# Local PostgreSQL (the password you chose when installing PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_postgres_password
DB_NAME=clink_dev
DB_NAME_TEST=clink_test

# Secret used to sign login tokens. Use any long random string.
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=7d
